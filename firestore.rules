rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // usuarios/{uid} - cada usuario so le/escreve o proprio documento
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // usuarios/{uid}/respostas/{id} - historico pessoal, so o dono acessa
      match /respostas/{respostaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // usuarios/{uid}/progresso/{topicoId} - progresso pessoal, so o dono acessa
      match /progresso/{topicoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // topicos/{id} - conteudo publico de leitura, escrita apenas via backend/admin
    match /topicos/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // questoes/{id} - conteudo publico de leitura, escrita apenas via backend/admin
    match /questoes/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
